---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { copy, paths, type Lang } from '../i18n';

const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const t = copy[lang].case;
const cases = (await getCollection('cases', (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const index = cases.findIndex((entry) => entry.id === `${lang}/${slug}`);
const entry = cases[index]!;
const next = cases[(index + 1) % cases.length]!;
const { Content } = await render(entry);
const other = lang === 'pt' ? 'en' : 'pt';
---

<Base lang={lang} alternate={paths[other].case(slug)} title={entry.data.title} description={entry.data.summary}>
  <article class="case">
    <a class="back" href={`${paths[lang].home}#projetos`}>← {t.back}</a>
    <header class="case-head">
      <p class="label">{String(index + 1).padStart(2, '0')} / {String(cases.length).padStart(2, '0')}</p>
      <h1>{entry.data.title}</h1>
      <p class="case-lede">{entry.data.summary}</p>
    </header>

    <figure class="case-visual">
      <img src={entry.data.image} alt={entry.data.imageAlt} width="1280" height="800" />
      <figcaption class="label">{entry.data.caption}</figcaption>
    </figure>

    <div class="case-grid">
      <aside>
        <dl class="case-spec">
          <div>
            <dt>{t.status}</dt>
            <dd>{entry.data.status}</dd>
          </div>
          <div>
            <dt>{t.role}</dt>
            <dd>{entry.data.role}</dd>
          </div>
          <div>
            <dt>{t.stack}</dt>
            <dd>
              <ul class="stack-list">
                {entry.data.stack.map((item) => <li>{item}</li>)}
              </ul>
            </dd>
          </div>
          {
            entry.data.links.length > 0 && (
              <div>
                <dt>{t.links}</dt>
                <dd>
                  <ul class="link-list">
                    {entry.data.links.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </aside>
      <div class="prose">
        <Content />
      </div>
    </div>

    <a class="next" href={paths[lang].case(next.id.split('/')[1]!)}>
      <span class="label">{t.next}</span>
      <span class="next-title">{next.data.title} →</span>
    </a>
  </article>
</Base>
